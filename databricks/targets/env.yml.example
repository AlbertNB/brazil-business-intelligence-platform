targets:
  prod:
    workspace:
      host: https://<databricks-workspace-url>.cloud.databricks.com

    variables:
      LANDING_ROOT: s3://bbip-landing-<env>-<account>-<region>/
      DBT_WAREHOUSE_ID: <databricks-sql-warehouse-id>
      DBT_CATALOG: <unity-catalog-name>

      # Pick ONE of the two blocks below, matching the storage_mode used in infrastructure/terraform.tfvars.

      # managed storage_mode (default): bronze/silver/gold are UC managed tables, no metadata bucket.
      STORAGE_MODE: managed
      AUTOLOADER_ROOT: /Volumes/<unity-catalog-name>/bronze/autoloader

      # external storage_mode: bronze/silver/gold/metadata each live in their own S3 bucket.
      # STORAGE_MODE: external
      # AUTOLOADER_ROOT: s3://bbip-metadata-<env>-<account>-<region>/autoloader
      # BRONZE_ROOT: s3://bbip-bronze-<env>-<account>-<region>/
